<?xml version="1.0"?>
<!--
  defined_mvp.urdf.xacro
  Minimal differential-drive robot for Defined Robotics simulation.

  Physical parameters (from defined_mvp.rdf.yaml):
    wheel_separation : 0.287 m
    wheel_radius     : 0.033 m

  Geometry:
    Base   : box    0.25 m x 0.20 m x 0.10 m
    Wheels : cylinder radius=0.033 m, width=0.020 m  (left + right)
    Caster : sphere  radius=0.010 m  (front, passive)

  Gazebo plugins:
    libgazebo_ros_diff_drive           → /cmd_vel, /odom, odom→base_footprint TF
    libgazebo_ros_joint_state_publisher → /joint_states
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="defined_mvp">

  <!-- ============================================================
       PROPERTIES
       ============================================================ -->
  <xacro:property name="base_length"      value="0.25"/>
  <xacro:property name="base_width"       value="0.20"/>
  <xacro:property name="base_height"      value="0.10"/>
  <xacro:property name="base_mass"        value="2.0"/>

  <xacro:property name="wheel_radius"     value="0.033"/>
  <xacro:property name="wheel_width"      value="0.020"/>
  <xacro:property name="wheel_mass"       value="0.1"/>
  <xacro:property name="wheel_separation" value="0.287"/>

  <xacro:property name="caster_radius"    value="0.010"/>
  <xacro:property name="caster_mass"      value="0.05"/>

  <!-- Derived offsets -->
  <!-- Wheel Y centre from robot centre line -->
  <xacro:property name="wheel_y"   value="${wheel_separation / 2.0}"/>
  <!-- Wheel Z relative to base_link centre; wheel tangent at base bottom -->
  <xacro:property name="wheel_z"   value="${-base_height / 2.0}"/>
  <!-- Caster at front edge of base, level with ground -->
  <xacro:property name="caster_x"  value="${base_length / 2.0 - caster_radius}"/>
  <xacro:property name="caster_z"  value="${-base_height / 2.0 - caster_radius}"/>

  <!-- ============================================================
       INERTIA HELPERS
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x + z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder inertia with axis along Y (after joint rotation) -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3.0*r*r + h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*r*r / 2.0}"            iyz="0.0"
        izz="${m*(3.0*r*r + h*h)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
        iyy="${2.0*m*r*r/5.0}" iyz="0.0"
        izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       BASE FOOTPRINT (ground-projection frame, Nav2 convention)
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- Lift base_link centre to wheel_radius above ground -->
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       BASE LINK
       ============================================================ -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="defined_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ============================================================
       WHEEL MACRO
       side   : "left" | "right"
       y_sign : +1 (left) | -1 (right)
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="side y_sign">

    <link name="${side}_wheel_link">
      <visual>
        <!-- Rotate 90° about X so the cylinder axis aligns with Y (roll axis) -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <!-- Inertia with spin axis = Y -->
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${side}_wheel_link"/>
      <origin xyz="0 ${y_sign * wheel_y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Gazebo: high friction so wheels grip the floor -->
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>

  </xacro:macro>

  <xacro:drive_wheel side="left"  y_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1"/>

  <!-- ============================================================
       CASTER WHEEL (passive, zero friction)
       ============================================================ -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <!-- Zero friction so caster slides freely -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- ============================================================
       LIDAR — 2D laser scanner on top of base
       360° scan, 0.12–3.5 m range, ~5.5 Hz, 360 samples
       Publishes sensor_msgs/LaserScan on /scan
       ============================================================ -->
  <xacro:property name="lidar_radius" value="0.030"/>
  <xacro:property name="lidar_height" value="0.020"/>
  <xacro:property name="lidar_mass"   value="0.1"/>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <!-- Centred on top of the base box -->
    <origin xyz="0 0 ${base_height / 2.0 + lidar_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>5.5</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>3.5</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================================================
       GAZEBO PLUGIN: DIFFERENTIAL DRIVE
       Subscribes : /cmd_vel  (geometry_msgs/Twist)
       Publishes  : /odom     (nav_msgs/Odometry)
       Broadcasts : odom → base_footprint TF
       ============================================================ -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Must match RDF yaml values -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <!-- TF for wheel joints comes from joint_state_publisher + robot_state_publisher -->
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

  <!-- ============================================================
       GAZEBO PLUGIN: JOINT STATE PUBLISHER
       Publishes  : /joint_states (sensor_msgs/JointState)
       Required by robot_state_publisher to compute wheel TF.
       ============================================================ -->
  <gazebo>
    <plugin name="gazebo_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
