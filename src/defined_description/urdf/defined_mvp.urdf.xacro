<?xml version="1.0"?>
<!--
  defined_mvp.urdf.xacro
  Minimal differential-drive robot for Defined Robotics simulation.

  Physical parameters (from defined_mvp.rdf.yaml):
    wheel_separation : 0.287 m
    wheel_radius     : 0.033 m

  Geometry:
    Base   : box    0.25 m x 0.20 m x 0.10 m
    Wheels : cylinder radius=0.033 m, width=0.020 m  (left + right)
    Caster : sphere  radius=0.010 m  (front, passive)

  Gz Sim plugins (declared in URDF <gazebo> blocks, converted to SDF by ros_gz):
    gz-sim-diff-drive-system        → subscribes /cmd_vel, publishes /odom (Gz topics)
    gz-sim-joint-state-publisher-system → publishes /joint_states (Gz topic)
    Lidar sensor                    → publishes /scan (Gz topic)

  All Gz topics are bridged to ROS2 by ros_gz_bridge in gazebo.launch.py.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="defined_mvp">

  <!-- ============================================================
       XACRO ARGS — overridable from launch (populated from ROBOT_* env vars)
       All have backward-compatible defaults matching the original URDF.
       NOTE: wheel_separation/wheel_radius are accepted for interface
       compatibility but NOT used — physical geometry and diff-drive
       odometry both use the hardcoded properties below.
       ============================================================ -->
  <xacro:arg name="wheel_separation"  default="0.287"/>
  <xacro:arg name="wheel_radius"      default="0.033"/>
  <xacro:arg name="has_lidar"         default="true"/>
  <xacro:arg name="lidar_range_min"   default="0.20"/>
  <xacro:arg name="lidar_range_max"   default="3.5"/>
  <xacro:arg name="lidar_samples"     default="720"/>
  <xacro:arg name="lidar_update_rate" default="20"/>
  <xacro:arg name="has_camera"        default="false"/>
  <xacro:arg name="camera_width"      default="640"/>
  <xacro:arg name="camera_height"     default="480"/>
  <xacro:arg name="camera_fps"        default="30"/>

  <!-- ============================================================
       PROPERTIES
       ============================================================ -->
  <xacro:property name="base_length"      value="0.25"/>
  <xacro:property name="base_width"       value="0.20"/>
  <xacro:property name="base_height"      value="0.10"/>
  <xacro:property name="base_mass"        value="2.0"/>

  <!-- Physical geometry values — fixed to match this URDF's visual model.
       The RDF wheel_separation/radius args are used ONLY by the diff-drive
       plugin for odometry, not for joint positions or visual geometry. -->
  <xacro:property name="wheel_radius"     value="0.033"/>
  <xacro:property name="wheel_width"      value="0.020"/>
  <xacro:property name="wheel_mass"       value="0.1"/>
  <xacro:property name="wheel_separation" value="0.287"/>

  <xacro:property name="caster_radius"    value="0.020"/>
  <xacro:property name="caster_mass"      value="0.05"/>

  <!-- Derived offsets -->
  <!-- Wheel Y centre from robot centre line -->
  <xacro:property name="wheel_y"   value="${wheel_separation / 2.0}"/>
  <!-- Wheel Z relative to base_link centre; wheel tangent at base bottom -->
  <xacro:property name="wheel_z"   value="${-base_height / 2.0}"/>
  <!-- Caster at front edge of base, bottom touching ground -->
  <xacro:property name="caster_x"  value="${base_length / 2.0 - caster_radius}"/>
  <xacro:property name="caster_z"  value="${-(base_height / 2.0 + wheel_radius - caster_radius)}"/>

  <!-- ============================================================
       INERTIA HELPERS
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y + z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x + z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x + y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Cylinder inertia with axis along Y (after joint rotation) -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3.0*r*r + h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*r*r / 2.0}"            iyz="0.0"
        izz="${m*(3.0*r*r + h*h)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${2.0*m*r*r/5.0}" ixy="0.0" ixz="0.0"
        iyy="${2.0*m*r*r/5.0}" iyz="0.0"
        izz="${2.0*m*r*r/5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       BASE FOOTPRINT (ground-projection frame, Nav2 convention)
       ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- Lift base_link centre so wheel axles are at ground level:
         base_link_z = base_height/2 + wheel_radius
         This ensures wheel bottoms touch ground and caster contacts ground. -->
    <origin xyz="0 0 ${base_height / 2.0 + wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       BASE LINK
       ============================================================ -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="defined_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                       x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ============================================================
       WHEEL MACRO
       side   : "left" | "right"
       y_sign : +1 (left) | -1 (right)
       ============================================================ -->
  <xacro:macro name="drive_wheel" params="side y_sign">

    <link name="${side}_wheel_link">
      <visual>
        <!-- Rotate 90° about X so the cylinder axis aligns with Y (roll axis) -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <!-- Inertia with spin axis = Y -->
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${side}_wheel_link"/>
      <origin xyz="-0.08 ${y_sign * wheel_y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Gz: high friction so wheels grip the floor -->
    <gazebo reference="${side}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

  </xacro:macro>

  <xacro:drive_wheel side="left"  y_sign="1"/>
  <xacro:drive_wheel side="right" y_sign="-1"/>

  <!-- ============================================================
       CASTER WHEEL (passive, zero friction)
       ============================================================ -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <!-- Zero friction so caster slides freely; stiff contact to prevent bouncing -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
  </gazebo>

  <!-- ============================================================
       LIDAR — conditional 2D laser scanner on top of base
       Controlled by has_lidar arg (default: true).
       Parameters driven by lidar_* args from ROBOT_* env vars.
       Publishes to Gz topic /scan (bridged to ROS2 by ros_gz_bridge)
       ============================================================ -->
  <xacro:if value="$(arg has_lidar)">
    <xacro:property name="lidar_radius" value="0.030"/>
    <xacro:property name="lidar_height" value="0.020"/>
    <xacro:property name="lidar_mass"   value="0.1"/>

    <link name="lidar_link">
      <visual>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <material name="lidar_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="lidar_link"/>
      <!-- Centred on top of the base box -->
      <origin xyz="0 0 ${base_height / 2.0 + lidar_height / 2.0}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="lidar_link">
      <sensor type="gpu_lidar" name="lidar_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>$(arg lidar_update_rate)</update_rate>
        <topic>/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>$(arg lidar_samples)</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>$(arg lidar_range_min)</min>
            <max>$(arg lidar_range_max)</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </ray>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ============================================================
       CAMERA — conditional RGB camera on front of base
       Controlled by has_camera arg (default: false).
       Parameters driven by camera_* args from ROBOT_* env vars.
       Publishes to Gz topic /camera/image_raw (bridged to ROS2)
       ============================================================ -->
  <xacro:if value="$(arg has_camera)">
    <xacro:property name="camera_box_size" value="0.02"/>
    <xacro:property name="camera_mass"     value="0.05"/>

    <link name="camera_link">
      <visual>
        <geometry>
          <box size="${camera_box_size} ${camera_box_size * 2} ${camera_box_size}"/>
        </geometry>
        <material name="camera_grey">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${camera_box_size} ${camera_box_size * 2} ${camera_box_size}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${camera_mass}"
                         x="${camera_box_size}" y="${camera_box_size * 2}" z="${camera_box_size}"/>
    </link>

    <!-- Camera optical frame: Z forward, X right, Y down (ROS convention) -->
    <link name="camera_optical_link"/>

    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="camera_link"/>
      <!-- Front-centre of base, slightly above centre -->
      <origin xyz="${base_length / 2.0} 0 ${base_height / 4.0}" rpy="0 0 0"/>
    </joint>

    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child  link="camera_optical_link"/>
      <!-- Rotate from URDF (X-forward) to optical (Z-forward) convention -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor type="camera" name="camera_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>$(arg camera_fps)</update_rate>
        <topic>/camera/image_raw</topic>
        <gz_frame_id>camera_optical_link</gz_frame_id>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>$(arg camera_width)</width>
            <height>$(arg camera_height)</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ============================================================
       GZ SIM PLUGIN: DIFFERENTIAL DRIVE
       Subscribes : /cmd_vel  (gz.msgs.Twist)
       Publishes  : /odom     (gz.msgs.Odometry)
       TF odom→base_footprint: published by odom_tf_broadcaster.py from /odom
       ============================================================ -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Odometry MUST use the same values as the physical joint positions
           in this URDF, not the RDF's real-hardware values.  The sim model
           has its own fixed geometry (0.287 m separation, 0.033 m radius)
           and the diff-drive plugin's odometry must be self-consistent
           with that geometry — otherwise SLAM/Nav2 break. -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <max_linear_acceleration>1.0</max_linear_acceleration>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <tf_topic>/odom_tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- ============================================================
       GZ SIM PLUGIN: JOINT STATE PUBLISHER
       Publishes  : /world/<world>/model/defined_mvp/joint_state (gz topic)
       Bridged to /joint_states by ros_gz_bridge.
       ============================================================ -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <update_rate>50</update_rate>
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
