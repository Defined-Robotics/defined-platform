<?xml version="1.0"?>
<!--
  room_10x10.sdf
  Defined Robotics — Gz Sim simulation world.

  A flat 10 m x 10 m indoor room with:
    - Ground plane
    - Four perimeter walls (0.20 m thick, 1.0 m tall)
    - Ambient + directional lighting
    - Gz Sim system plugins (Physics, SceneBroadcaster, Sensors, UserCommands)

  Robot spawned separately by gazebo.launch.py via ros_gz_sim create.
-->
<sdf version="1.9">
  <world name="room_10x10">

    <!-- ============================================================
         GZ SIM SYSTEM PLUGINS
         ============================================================ -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::v8::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::v8::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::v8::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::v8::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ============================================================
         PHYSICS
         ============================================================ -->
    <physics name="1ms" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.4</sor>
        </solver>
        <constraints>
          <cfm>1e-5</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000</contact_max_correcting_vel>
          <contact_surface_layer>0.01</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ============================================================
         SCENE / LIGHTING
         ============================================================ -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Directional sun light -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ============================================================
         GROUND PLANE
         ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         ROOM WALLS
         Room: 10 m x 10 m, centred at origin.
         Wall thickness: 0.20 m, height: 1.0 m.
         ============================================================ -->

    <!-- NORTH wall: y = +5.0, runs along X axis -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10.0 0.2 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10.0 0.2 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- SOUTH wall: y = -5.0 -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>10.0 0.2 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>10.0 0.2 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- EAST wall: x = +5.0, runs along Y axis -->
    <model name="wall_east">
      <static>true</static>
      <pose>5.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- WEST wall: x = -5.0 -->
    <model name="wall_west">
      <static>true</static>
      <pose>-5.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 10.4 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         FURNITURE — obstacles for navigation testing
         All placed with >=1.0 m clearance from walls and each other
         ============================================================ -->

    <!-- Table (northeast quadrant): 1.2 m x 0.7 m top, 0.75 m tall -->
    <model name="table">
      <static>true</static>
      <pose>2.5 2.5 0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.7 0.75</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.7 0.75</size></box></geometry>
          <material><ambient>0.45 0.3 0.18 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Chair at table: 0.45 m x 0.45 m x 0.85 m -->
    <model name="chair_1">
      <static>true</static>
      <pose>2.5 1.5 0.425 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.85</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.85</size></box></geometry>
          <material><ambient>0.3 0.2 0.12 1</ambient><diffuse>0.4 0.28 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Second chair opposite side -->
    <model name="chair_2">
      <static>true</static>
      <pose>2.5 3.5 0.425 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.85</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.85</size></box></geometry>
          <material><ambient>0.3 0.2 0.12 1</ambient><diffuse>0.4 0.28 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bookshelf against north wall (northwest): 1.0 m x 0.35 m x 1.5 m -->
    <model name="bookshelf">
      <static>true</static>
      <pose>-3.0 4.3 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.35 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.35 1.5</size></box></geometry>
          <material><ambient>0.35 0.22 0.1 1</ambient><diffuse>0.42 0.28 0.14 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cabinet against west wall: 0.5 m x 0.9 m x 1.0 m -->
    <model name="cabinet">
      <static>true</static>
      <pose>-4.3 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.9 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.9 1.0</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Sofa (southwest quadrant): 1.8 m x 0.7 m x 0.65 m -->
    <model name="sofa">
      <static>true</static>
      <pose>-2.0 -3.5 0.325 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.7 0.65</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.7 0.65</size></box></geometry>
          <material><ambient>0.25 0.3 0.45 1</ambient><diffuse>0.3 0.35 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Coffee table in front of sofa: 0.9 m x 0.5 m x 0.4 m -->
    <model name="coffee_table">
      <static>true</static>
      <pose>-2.0 -2.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.5 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 0.5 0.4</size></box></geometry>
          <material><ambient>0.45 0.3 0.18 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small side table (southeast): 0.4 m x 0.4 m x 0.55 m -->
    <model name="side_table">
      <static>true</static>
      <pose>3.5 -3.5 0.275 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.4 0.55</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.4 0.55</size></box></geometry>
          <material><ambient>0.45 0.3 0.18 1</ambient><diffuse>0.55 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
