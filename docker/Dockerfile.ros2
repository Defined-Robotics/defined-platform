# Defined Robotics — ROS2 Development Container
# Based on ROS2 Jazzy for ARM64/AMD64
FROM osrf/ros:jazzy-desktop-full

# Install Nav2, Gz Sim, rosbridge, BehaviorTree.CPP, and tooling.
#
# Package notes:
#   ros-jazzy-navigation2        : full Nav2 stack (planner, controller, amcl, bt_navigator, …)
#   ros-jazzy-nav2-bringup       : nav2_bringup launch helpers
#   ros-jazzy-ros-gz             : Gz Sim meta-package (sim + bridge + image)
#   ros-jazzy-ros-gz-sim         : Gz Sim launch helpers and spawn node
#   ros-jazzy-ros-gz-bridge      : bidirectional Gz Transport ↔ ROS2 bridge
#   ros-jazzy-rosbridge-suite    : WebSocket bridge for dashboard
#   ros-jazzy-behaviortree-cpp   : BehaviorTree.CPP runtime (for defined_runtime)
#   ros-jazzy-robot-state-publisher : publishes /robot_description + TF from URDF
#   ros-jazzy-joint-state-publisher : publishes /joint_states for static joints
#   ros-jazzy-xacro              : xacro macro processor (URDF → URDF)
#   ros-jazzy-tf2-ros            : TF2 core
#   ros-jazzy-tf2-tools          : tf2_echo, view_frames diagnostic utilities
#   ros-jazzy-rviz2              : RViz2 visualiser (for the viz Docker profile)
#   python3-colcon-common-extensions : colcon build tool
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-slam-toolbox \
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-rosbridge-suite \
    ros-jazzy-foxglove-bridge \
    ros-jazzy-behaviortree-cpp \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-xacro \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-tools \
    ros-jazzy-teleop-twist-keyboard \
    python3-colcon-common-extensions \
    libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user to run all ROS2 processes (C1)
RUN groupadd -r ros && useradd -r -g ros -d /ros2_ws -s /bin/bash ros

# Create workspace and hand ownership to ros user
RUN mkdir -p /ros2_ws/src /ros2_ws/build /ros2_ws/install /ros2_ws/log \
    && chown -R ros:ros /ros2_ws
WORKDIR /ros2_ws

# Copy source packages (as root, then fix ownership)
COPY src/ /ros2_ws/src/
RUN chown -R ros:ros /ros2_ws/src

# Build workspace as non-root user
USER ros
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build --packages-ignore defined_runtime

# Entrypoint (needs root to copy, then switch back)
USER root
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Drop back to non-root for runtime
USER ros

# Rosbridge process health: check the WebSocket port is open (W3)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD bash -c 'echo > /dev/tcp/localhost/9090' 2>/dev/null || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
