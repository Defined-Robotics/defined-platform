# Defined Robotics — ROS2 Development Container
# Based on ROS2 Jazzy for ARM64/AMD64
FROM osrf/ros:jazzy-desktop-full

# Install Nav2, Gz Sim, rosbridge, BehaviorTree.CPP, and tooling.
#
# Package notes:
#   ros-jazzy-navigation2        : full Nav2 stack (planner, controller, amcl, bt_navigator, …)
#   ros-jazzy-nav2-bringup       : nav2_bringup launch helpers
#   ros-jazzy-ros-gz             : Gz Sim meta-package (sim + bridge + image)
#   ros-jazzy-ros-gz-sim         : Gz Sim launch helpers and spawn node
#   ros-jazzy-ros-gz-bridge      : bidirectional Gz Transport ↔ ROS2 bridge
#   ros-jazzy-rosbridge-suite    : WebSocket bridge for dashboard
#   ros-jazzy-behaviortree-cpp   : BehaviorTree.CPP runtime (for defined_runtime)
#   ros-jazzy-robot-state-publisher : publishes /robot_description + TF from URDF
#   ros-jazzy-joint-state-publisher : publishes /joint_states for static joints
#   ros-jazzy-xacro              : xacro macro processor (URDF → URDF)
#   ros-jazzy-tf2-ros            : TF2 core
#   ros-jazzy-tf2-tools          : tf2_echo, view_frames diagnostic utilities
#   ros-jazzy-rviz2              : RViz2 visualiser (for the viz Docker profile)
#   python3-colcon-common-extensions : colcon build tool
# Upgrade base-image packages first so that libraries like fastcdr
# match the ABI expected by newer Nav2/rosbridge releases.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ros-jazzy-navigation2 \
    ros-jazzy-nav2-bringup \
    ros-jazzy-slam-toolbox \
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-sim \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-rosbridge-suite \
    ros-jazzy-foxglove-bridge \
    ros-jazzy-behaviortree-cpp \
    ros-jazzy-robot-state-publisher \
    ros-jazzy-joint-state-publisher \
    ros-jazzy-xacro \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-tools \
    ros-jazzy-teleop-twist-keyboard \
    ros-jazzy-turtlebot3 \
    ros-jazzy-turtlebot3-msgs \
    ros-jazzy-turtlebot3-simulations \
    python3-colcon-common-extensions \
    libgl1-mesa-dri \
    clang-tidy \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user to run all ROS2 processes (C1)
RUN groupadd -r ros && useradd -r -g ros -d /ros2_ws -s /bin/bash ros

# Create workspace and hand ownership to ros user
RUN mkdir -p /ros2_ws/src /ros2_ws/build /ros2_ws/install /ros2_ws/log \
    && chown -R ros:ros /ros2_ws
WORKDIR /ros2_ws

# Copy source packages (as root, then fix ownership)
COPY src/ /ros2_ws/src/

# Clone m-explore-ros2 (frontier exploration) — only explore_lite, skip map_merge (Jazzy compat)
# Pinned to a specific commit for reproducible builds. To upgrade: run
#   git ls-remote https://github.com/robo-friends/m-explore-ros2.git HEAD
# update MEXPLORE_SHA below, re-verify the patches still apply, and rebuild.
#
# Patches applied after copy:
#   1. Add 'autostart' param (default false) — node stays idle until /explore/resume
#   2. Wrap auto-start block in if(autostart_) — skip auto-navigation when paused
#   3. Clear frontier blacklist on resume() — prevents "All frontiers traversed" after restart
ARG MEXPLORE_SHA=86742bff6edd53fcce16f99dbc8c06ed5d7eed22
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && \
    rm -rf /var/lib/apt/lists/* && \
    git clone https://github.com/robo-friends/m-explore-ros2.git /tmp/m-explore && \
    git -C /tmp/m-explore checkout ${MEXPLORE_SHA} && \
    cp -r /tmp/m-explore/explore /ros2_ws/src/explore_lite && \
    cp -r /tmp/m-explore/explore_lite_msgs /ros2_ws/src/explore_lite_msgs && \
    rm -rf /tmp/m-explore && \
    # Patch 1: Add 'autostart' parameter (default false) to explore_lite \
    sed -i '/declare_parameter<bool>("return_to_init", false);/a\  this->declare_parameter<bool>("autostart", false);' \
        /ros2_ws/src/explore_lite/src/explore.cpp && \
    grep -q 'declare_parameter<bool>("autostart", false)' /ros2_ws/src/explore_lite/src/explore.cpp \
        || { echo "ERROR: Patch 1a (autostart declaration) did not apply"; exit 1; } && \
    sed -i '/get_parameter("robot_base_frame", robot_base_frame_);/a\  bool autostart_;\n  this->get_parameter("autostart", autostart_);' \
        /ros2_ws/src/explore_lite/src/explore.cpp && \
    grep -q 'get_parameter("autostart", autostart_)' /ros2_ws/src/explore_lite/src/explore.cpp \
        || { echo "ERROR: Patch 1b (autostart read) did not apply"; exit 1; } && \
    # Patch 2: Wrap auto-start block in if(autostart_) — use python for multi-line replace \
    python3 -c "f='/ros2_ws/src/explore_lite/src/explore.cpp'; s=open(f).read(); old='  // Start exploration right away\n  auto status_msg = explore_lite_msgs::msg::ExploreStatus();\n  status_msg.status = explore_lite_msgs::msg::ExploreStatus::EXPLORATION_STARTED;\n  status_pub_->publish(status_msg);\n  makePlan();'; new='  if (autostart_) {\n  // Start exploration right away\n  auto status_msg = explore_lite_msgs::msg::ExploreStatus();\n  status_msg.status = explore_lite_msgs::msg::ExploreStatus::EXPLORATION_STARTED;\n  status_pub_->publish(status_msg);\n  makePlan();\n  } else {\n    exploring_timer_->cancel();\n    RCLCPP_INFO(logger_, \"explore_lite started in paused mode\");\n  }'; result = s.replace(old, new, 1); assert result != s, 'ERROR: Patch 2 (autostart guard) did not apply — upstream source may have changed'; open(f,'w').write(result)" && \
    # Patch 3: Clear frontier blacklist on resume() \
    sed -i '/resuming_ = true;/a\  frontier_blacklist_.clear();' \
        /ros2_ws/src/explore_lite/src/explore.cpp && \
    grep -q 'frontier_blacklist_.clear()' /ros2_ws/src/explore_lite/src/explore.cpp \
        || { echo "ERROR: Patch 3 (blacklist clear) did not apply"; exit 1; }

RUN chown -R ros:ros /ros2_ws/src

# Build workspace as non-root user
USER ros
RUN . /opt/ros/jazzy/setup.sh && \
    colcon build

# Entrypoint (needs root to copy, then switch back)
USER root
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Drop back to non-root for runtime
USER ros

# Rosbridge process health: check the WebSocket port is open (W3)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD bash -c 'echo > /dev/tcp/localhost/9090' 2>/dev/null || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
